{
  "manifest_version": 3,
  "name": "Quota Gauge for claude.ai",
  "version": "1.0.0",
  "description": "Your Claude plan's 5-hour session and weekly usage, right above the prompt on claude.ai, with reset times and alerts.",
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "gauge.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon.png"
  }
}
